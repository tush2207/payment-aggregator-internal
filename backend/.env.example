# Database Connection Strings
ORACLE_CONNECTION_STRING=oracle+oracledb://PAWS_USER:Password1234@localhost:1521/ORCLPDB
MSSQL_CONNECTION_STRING=mssql+pyodbc://username:password@hostname:1433/database_name?driver=ODBC+Driver+17+for+SQL+Server
SQL_LITE_CONNECTION_STRING=sqlite:///./sql_lite.db

# LDAP Configuration
LDAP_SERVER=ldap://your-ldap-server
LDAP_BASE_DN=DC=yourdomain,DC=com

# Application Configuration
CENTRAL_OFFICE_DEPARTMENT_CODE=CO08646
DEV_MODE=True

# Email & SMTP Configuration
# Examples:
# For Bank SMTP Relay: SMTP_HOST=mail.cbi.co.in, SMTP_PORT=25, SMTP_USE_TLS=False
# For Gmail / GSuite:  SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=True
# For Office 365:      SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_USE_TLS=True
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@cbi.co.in
SMTP_PASSWORD=your_smtp_password_or_app_token
SMTP_FROM_EMAIL=no-reply.papg@cbi.co.in
SMTP_FROM_NAME="Central Bank of India - Payment Aggregator Portal"
SMTP_USE_TLS=True
SMTP_USE_SSL=False
EMAIL_ENABLED=True
PORTAL_BASE_URL=http://localhost:5173

