# ==============================================================================
#  CENTRAL BANK OF INDIA — PAYMENT AGGREGATOR & RFQ PORTAL (PAPG)
#  ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# 1. Primary Application Database (Oracle DB / SQLite)
DEV_MODE="False"
ORACLE_CONNECTION_STRING="oracle+oracledb://PAWS_USER:Password1234@localhost:1521/?service_name=FREEPDB1"
SQL_LITE_CONNECTION_STRING="sqlite:///./paws.db"

# 2. Secondary Master Database (MSSQL Employee Directory)
MSSQL_CONNECTION_STRING="mssql+pyodbc://devApp1:%40dm%21n321@10.1.34.186:1433/MasterDB?driver=ODBC+Driver+17+for+SQL+Server"

# 3. Active Directory & LDAP
LDAP_SERVER="ldaps://DRCSVR1.CBI.CO.IN"
LDAP_BASE_DN="DC=CBI,DC=CO,DC=IN"
CENTRAL_OFFICE_DEPARTMENT_CODE="CO08646"
ADMIN_USERS="139822,115019,CE25000014,138922"

# 4. Email & SMTP Notification Dispatch Service
ENABLE_MAIL="True"
EMAIL_ENABLED="True"
# Bank Internal SMTP Server (matches dmz-backend):
SMTP_HOST="email.centralbankofindia.org.in"
# Alternative IP: SMTP_HOST="10.16.33.177"
SMTP_PORT="25"
SMTP_USER="paws_notifiy@centralbankofindia.org.in"
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="paws_notifiy@centralbankofindia.org.in"
SMTP_FROM_NAME="Central Bank of India - Payment Aggregator Portal"

# 5. Frontend Portal URLs
PORTAL_BASE_URL="http://localhost:5173"
AGGREGATOR_PORTAL_URL="http://localhost:5174"

# 6. AES-256-GCM Data & Payload Encryption (RBI & NPCI Compliant)
ENCRYPTION_KEY="CBI_PAPG_SECURE_AES256_KEY_2026_PROD#!"
DATA_ENCRYPTION_ENABLED="True"
E2E_PAYLOAD_ENCRYPTION_FORCE="False"

